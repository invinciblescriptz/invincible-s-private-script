local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer

LocalPlayer.Idled:Connect(function()
	VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
	task.wait(1)
	VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
end)

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AntiAFKTimer"
screenGui.ResetOnSpawn = false
screenGui.Parent = game:GetService("CoreGui")
local timerLabel = Instance.new("TextLabel")
timerLabel.Size = UDim2.new(0, 180, 0, 22)
timerLabel.Position = UDim2.new(0.5, -90, 0, 8)
timerLabel.BackgroundTransparency = 1
timerLabel.TextColor3 = Color3.fromRGB(255, 255, 255) 
timerLabel.Font = Enum.Font.FredokaOne
timerLabel.TextSize = 16
timerLabel.Text = "Anti AFK: 00:00"
timerLabel.Parent = screenGui

local gradient = Instance.new("UIGradient")
gradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(200, 40, 40)), 
	ColorSequenceKeypoint.new(0.33, Color3.fromRGB(160, 20, 20)), 
	ColorSequenceKeypoint.new(0.66, Color3.fromRGB(90, 10, 10)),  
	ColorSequenceKeypoint.new(1, Color3.fromRGB(10, 10, 0))         
})
gradient.Parent = timerLabel



local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(0, 0, 0)
stroke.Thickness = 1.5
stroke.Transparency = 0.3
stroke.Parent = timerLabel

task.spawn(function()
	local seconds = 0
	while true do
		task.wait(1)
		seconds += 1
		local mins = math.floor(seconds / 60)
		local secs = seconds % 60
		timerLabel.Text = string.format("Anti AFK: %02d:%02d", mins, secs)
	end
end)

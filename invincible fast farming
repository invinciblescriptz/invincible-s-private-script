packs:AddButton("Fast Farm Combo", function()
    local equipEvent = ReplicatedStorage.rEvents.equipPetEvent

    if player:FindFirstChild("petsFolder") then
        for _, folder in pairs(player.petsFolder:GetChildren()) do
            if folder:IsA("Folder") then
                for _, pet in pairs(folder:GetChildren()) do
                    pcall(function()
                        equipEvent:FireServer("unequipPet", pet)
                    end)
                end
            end
        end
    end

    task.wait(0.15)

    local equippedOmega = 0
    local equippedHound = 0

    local unique = player.petsFolder:FindFirstChild("Unique")
    if unique then
        for _, pet in pairs(unique:GetChildren()) do
            if pet.Name == "Omega Overlord" and equippedOmega < 5 then
                pcall(function()
                    equipEvent:FireServer("equipPet", pet)
                end)
                equippedOmega += 1
                task.wait(0.05)
            elseif pet.Name == "Powercore Hound" and equippedHound < 7 then
                pcall(function()
                    equipEvent:FireServer("equipPet", pet)
                end)
                equippedHound += 1
                task.wait(0.05)
            end

            if equippedOmega >= 5 and equippedHound >= 7 then
                break
            end
        end
    end
end)



local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lp = Players.LocalPlayer

local PetPriority = {
    "Omega Overlord",
    "Swift Samurai",
    "Mythic Boss Pet",
    "Legendary Boss Pet",
    "Rainbow Boss Pet",
    "Epic Boss Pet",
    "Rare Boss Pet",
    "Common Boss Pet"
}

local MaxPets = 12

local function unequipAllPets()
    local petsFolder = lp:FindFirstChild("petsFolder")
    if not petsFolder then return end
    for _, folder in pairs(petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, pet in pairs(folder:GetChildren()) do
                pcall(function()
                    ReplicatedStorage.rEvents.equipPetEvent:FireServer("unequipPet", pet)
                end)
            end
        end
    end
    task.wait(0.15)
end

local function equipPetsByName(petName, amount)
    local petsFolder = lp:FindFirstChild("petsFolder")
    if not petsFolder then return 0 end
    local unique = petsFolder:FindFirstChild("Unique")
    if not unique then return 0 end
    local equipped = 0
    for _, pet in pairs(unique:GetChildren()) do
        if pet.Name == petName and equipped < amount then
            pcall(function()
                ReplicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", pet)
            end)
            equipped = equipped + 1
            task.wait(0.05)
        end
    end
    return equipped
end

local function BestRepPets()
    unequipAllPets()
    local remaining = MaxPets
    for _, petName in ipairs(PetPriority) do
        if remaining <= 0 then break end
        local equipped = equipPetsByName(petName, remaining)
        remaining = remaining - equipped
    end
end

packs:AddButton("Best Rep Speed Pets", function()
    BestRepPets()
end)

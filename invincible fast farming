local MAX_PETS = 12

local function managePets(petName)
    local petsFolder = player:FindFirstChild("petsFolder")
    if not petsFolder then return false end

    local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
    if not rEvents then return false end

    local equipEvent = rEvents:FindFirstChild("equipPetEvent")
    if not equipEvent then return false end

    for _, folder in ipairs(petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, pet in ipairs(folder:GetChildren()) do
                pcall(function()
                    equipEvent:FireServer("unequipPet", pet)
                end)
            end
        end
    end

    task.wait(0.15)

    local unique = petsFolder:FindFirstChild("Unique")
    if not unique then return false end

    local equipped = 0
    for _, pet in ipairs(unique:GetChildren()) do
        if pet.Name == petName then
            pcall(function()
                equipEvent:FireServer("equipPet", pet)
            end)
            equipped += 1
            if equipped >= MAX_PETS then break end
        end
    end

    return equipped > 0
end

local function getRebirthRemote()
    local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
    if not rEvents then return nil end
    return rEvents:FindFirstChild("rebirthRemote")
end

local function doRebirth(petName)
    if not activeMode then return false end

    local rebirthRemote = getRebirthRemote()
    if not rebirthRemote then return false end

    local currentRebirths = rebirthsStat.Value
    local strengthTarget = 5000 + (currentRebirths * 2550)

    while activeMode and strengthStat.Value < strengthTarget do
        local reps = (player.MembershipType == Enum.MembershipType.Premium) and 12 or 20

        for _ = 1, reps do
            if not activeMode then return false end
            pcall(function()
                muscleEvent:FireServer("rep")
            end)
        end
        task.wait(0.02)
    end

    if not activeMode then return false end

    managePets(petName)
    task.wait(0.25)

    local before = rebirthsStat.Value
    repeat
        if not activeMode then return false end
        pcall(function()
            rebirthRemote:InvokeServer("rebirthRequest")
        end)
        task.wait(0.05)
    until rebirthsStat.Value > before or not activeMode

    return rebirthsStat.Value > before
end

local MODES = {
    normal = {
        petBefore = "Swift Samurai",
        petRebirth = "Tribal Overlord"
    },
    new = {
        petBefore = "Omega Overlord",
        petRebirth = "Powercore Hound"
    }
}

local function fastRebirthLoop(modeName)
    local config = MODES[modeName]
    if not config then return end

    while activeMode == modeName do
        managePets(config.petBefore)
        if activeMode ~= modeName then break end
        doRebirth(config.petRebirth)
        if activeMode ~= modeName then break end
        task.wait(0.5)
    end
end


    local hours = math.floor((elapsed % 86400) / 3600)
    local minutes = math.floor((elapsed % 3600) / 60)
    local seconds = math.floor(elapsed % 60)

    local status
    if activeMode == "normal" then
        status = "Fast Rebirthing"
    elseif activeMode == "new" then
        status = "Fast Rebirthing [New]"
    elseif activeMode == "nopacks" then
        status = "Fast Rebirthing [No Packs]"
    elseif elapsed > 0 then
        status = "Rebirthing Paused"
    else

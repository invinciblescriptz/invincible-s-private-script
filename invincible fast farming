        if not character or not character.Parent or not hrp or not hrp.Parent then
            character = LocalPlayer.Character
            if not character then return end
            hrp = character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
        end

        local boss = nil
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj.Name == selectedBoss and (obj:IsA("Model") or obj:IsA("Folder") or obj:IsA("BasePart")) then
                boss = obj
                break
            end
        end

        if not boss then return end

        local targetPart = boss:FindFirstChild("HumanoidRootPart")
            or (boss:FindFirstChild("Humanoid") and boss.Humanoid.RootPart)
            or boss:FindFirstChildWhichIsA("BasePart")
            or (boss:IsA("BasePart") and boss)

        if targetPart then
            hrp.CFrame = targetPart.CFrame + Vector3.new(0, 45, 0)
        end
    end)
end)

























